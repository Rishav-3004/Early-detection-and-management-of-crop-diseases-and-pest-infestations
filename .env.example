# Application Environment
ENVIRONMENT=development
DEBUG=True
DEMO_MODE=True

# Backend Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Local Development):
DATABASE_URL=sqlite+aiosqlite:///./crop_disease.db
# PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/crop_db

# File Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# AI / ML Model
MODEL_PROVIDER=mock
MODEL_VERSION=v1.2.0-agrishield

# Weather Integration
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
